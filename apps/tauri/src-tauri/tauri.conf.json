{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiAN Studio",
  "version": "1.0.2",
  "identifier": "com.aian-studio.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:desktop",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AiAN Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost app:; base-uri 'self'; object-src 'none'; script-src 'self' app:; frame-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' tauri://localhost app:; img-src 'self' data: blob: https: tauri://localhost app: http://koma-image.localhost https://koma-image.localhost koma-image:; connect-src 'self' tauri://localhost app: ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https:; font-src 'self' data: http://koma-font.localhost https://koma-font.localhost koma-font:; worker-src 'self' blob: app: https://challenges.cloudflare.com",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**"
        ]
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© AiAN Studio",
    "category": "Productivity",
    "shortDescription": "Scanlation toolkit",
    "longDescription": "AiAN Studio is a desktop workspace for translating, cleaning and typesetting manga, manhwa and webtoons.",
    "fileAssociations": [
      {
        "ext": [
          "cbz"
        ],
        "name": "AiAN Comic Archive (CBZ)",
        "description": "AiAN Studio comic book archive (zip)",
        "mimeType": "application/vnd.comicbook+zip"
      },
      {
        "ext": [
          "cb7"
        ],
        "name": "AiAN Comic Archive (CB7)",
        "description": "AiAN Studio comic book archive (7z)",
        "mimeType": "application/vnd.comicbook+7zip"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "AiAN PDF Document",
        "description": "AiAN Studio PDF document",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": false
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": [
        "aianstudio"
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/meishaven/manhwa-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NjcwODIxODU5MzkwNDIKUldSQ2tKT0ZJUWhudGRIcW1qd3ZmaVVTWEk0aE1QZzZmQ1FMU0dJTC9ReGwxTHlwblRpbG5EdmsK",
      "requireSignedVersion": true
    }
  }
}
